# Ignore everything by default
*

# Config files
!package.json
!bun.lock
!tsconfig.json
!tsconfig.base.json
!bunfig.toml

# Web server + API routes
!apps/web/

# CLI tools
!apps/cli-tools/monday-cli/
!apps/cli-tools/sharepoint-cli/
!apps/cli-tools/email-cli/
!apps/cli-tools/pdf-analysis-cli/

# Workers
!apps/workers/estimate-poller/lib/
!apps/workers/contract-intake/lib/

# Contract utilities (html-to-text, spam-filter, extraction)
!apps/contract/db/lib/
!apps/contract/db/sync/extract-estimates.ts

# Shared libraries
!lib/

# Frontend dependencies (hooks, styles)
!hooks/
!styles/

# Exclude heavy data from lib/ (databases, downloaded files, logs)
lib/**/*.db
lib/**/*.db-journal
lib/**/*.db-shm
lib/**/*.db-wal
lib/**/*.db.bak*
lib/db/monday-files/
lib/db/hub-corrupted.db
lib/db/*.log
lib/db/app.db
