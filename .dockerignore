# Ignore everything by default
*

# Config files
!package.json
!bun.lock
!tsconfig.json
!tsconfig.base.json
!bunfig.toml

# Web server + API routes
!apps/web/

# Background jobs — webhook receiver + job queue + sync timers + notifications
!apps/background-jobs/

# CF Workers — shared modules referenced by background-jobs
!apps/cf-workers/

# Dust permit MCP — client + types used by background-jobs permit-sync
!apps/dust-permits-mcp/client.ts
!apps/dust-permits-mcp/types.ts

# Document processing
!packages/documents/

# Packages
!packages/sharepoint/
!packages/monday/
!packages/email/
!packages/estimates/
!packages/permits/
!packages/takeoff/
!packages/contracts/
!packages/aqdata/
!packages/enrichment/

# Permit worker (browser automation)
!apps/dust-permits/
!apps/aqdata-worker/

# BC worker (BuildingConnected auth)
!apps/bc-worker/

# Shared infrastructure (VNC startup scripts, etc.)
!infra/

# Shared libraries
!lib/

# Frontend dependencies in their package locations are included via apps/web/

# Exclude heavy data from lib/ (databases, downloaded files, logs)
lib/**/*.db
lib/**/*.db-journal
lib/**/*.db-shm
lib/**/*.db-wal
lib/**/*.db.bak*
lib/db/monday-files/
lib/db/hub-corrupted.db
lib/db/*.log
lib/db/app.db
