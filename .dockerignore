# Ignore everything by default
*

# Config files
!package.json
!bun.lock
!tsconfig.json
!tsconfig.base.json
!bunfig.toml

# Web server + API routes
!apps/web/

# Webhook receiver + background worker
!apps/webhooks/

# Document processing
!packages/documents/

# Workers
!apps/workers/estimate-poller/lib/
!apps/workers/estimate-email-linker/lib/
!apps/workers/outlook-folder-watcher/lib/
!apps/workers/estimates-sync-worker/lib/
!packages/sharepoint/
!packages/monday/
!packages/email/
!packages/estimates/
!packages/takeoff/


# Notifications worker
!apps/workers/notifications/cli/
!apps/workers/notifications/lib/

# Permit worker (browser automation)
!packages/dust-permits/

# Shared libraries
!lib/

# Frontend dependencies in their package locations are included via apps/web/

# Exclude heavy data from lib/ (databases, downloaded files, logs)
lib/**/*.db
lib/**/*.db-journal
lib/**/*.db-shm
lib/**/*.db-wal
lib/**/*.db.bak*
lib/db/monday-files/
lib/db/hub-corrupted.db
lib/db/*.log
lib/db/app.db
