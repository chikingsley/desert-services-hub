# =============================================================================
# SUPABASE & DATABASE CONFIGURATION (HUB)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key

# Database Connection Strings
DATABASE_URL="postgresql://postgres:password@host:6543/postgres"
SESSION_POOLER_URL="postgresql://postgres:password@host:5432/postgres"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"
SUPABASE_DB_PASSWORD=your-db-password

# =============================================================================
# MONDAY.COM CONFIGURATION (WORKBENCH)
# =============================================================================
MONDAY_API_KEY=your-monday-api-key
MONDAY_WORKSPACE="Desert Services CRM"
MONDAY_CONTACTS_BOARD_ID=your-board-id
MONDAY_CONTRACTORS_BOARD_ID=your-board-id

# =============================================================================
# AI & RESEARCH API KEYS (WORKBENCH)
# =============================================================================
JINA_API_KEY=your-jina-api-key
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# MICROSOFT GRAPH / AZURE AD (WORKBENCH)
# =============================================================================
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
TARGET_MAILBOXES=your-email@domain.com
CONTRACTS_GROUP_ID=your-group-id
CONTRACTS_GROUP_EMAIL=your-group-email@domain.com

# =============================================================================
# BUILDINGCONNECTED BODY-LINK AUTOMATION (OPTIONAL)
# =============================================================================
EMAIL_BODY_LINK_PLAYWRIGHT=1
EMAIL_BODY_LINK_PLAYWRIGHT_HEADLESS=1
EMAIL_BODY_LINK_PLAYWRIGHT_TIMEOUT_MS=45000
EMAIL_BODY_LINK_PLAYWRIGHT_DOWNLOAD_WAIT_MS=8000
EMAIL_BODY_LINK_PLAYWRIGHT_MAX_ATTEMPTS=5
EMAIL_BODY_LINK_PLAYWRIGHT_STORAGE_STATE_PATH=/app/data/attachments/body-links-auth/state.json
EMAIL_BODY_LINK_PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36
# Optional direct login fallback when storage state is missing/expired.
BUILDINGCONNECTED_LOGIN_EMAIL=your-buildingconnected-email
BUILDINGCONNECTED_LOGIN_PASSWORD=your-buildingconnected-password
BUILDINGCONNECTED_LOGIN_START_URL=https://app.buildingconnected.com/
BUILDINGCONNECTED_AUTH_MANUAL_TIMEOUT_MS=1200000
BACKGROUND_JOBS_BASE_URL=http://background-jobs:4747
BUILDINGCONNECTED_AUTH_VNC_PORT=6081
# Public noVNC endpoint (recommended: dedicated Cloudflare tunnel hostname).
BUILDINGCONNECTED_AUTH_VNC_URL=https://buildingconnected-vnc.desertservices.app/vnc.html?autoconnect=true&resize=scale&reconnect=true&reconnect_delay=2000&view_only=false&shared=true
BACKGROUND_JOBS_VNC_ENABLED=1
BACKGROUND_JOBS_VNC_RESOLUTION=1920x1080

# =============================================================================
# EXTERNAL INTEGRATIONS (WORKBENCH)
# =============================================================================
PEOPLE_DATA_LABS_API_KEY=your-api-key
CLOUDFLARE_API_TOKEN=your-api-token
GOOGLE_MAPS_API_KEY=your-api-key
MARICOPA_COUNTY_API_TOKEN=your-api-token

# =============================================================================
# N8N AUTOMATION (WORKBENCH)
# =============================================================================
N8N_API_KEY=your-n8n-api-key
N8N_BASE_URL=https://n8n.your-domain.app

# =============================================================================
# TRIGGER.DEV (BACKGROUND JOBS PLATFORM)
# =============================================================================
TRIGGER_SECRET_KEY=tr_dev_your-secret-key
TRIGGER_API_URL=https://trigger.desertservices.app
PERMIT_WORKER_URL=http://localhost:47822

# =============================================================================
# AQDATA PIPELINE (OPTIONAL)
# =============================================================================
AQDATA_WORKER_URL=http://aqdata-worker:47823
AQDATA_SYNC_ENABLED=1
AQDATA_DETAIL_SCRAPE_ENABLED=1
AQDATA_DETAIL_SCRAPE_BATCH_SIZE=10
AQDATA_SCRAPE_INTERVAL_MS=900000
AQDATA_COMPANY_NAME=Desert Services
AQDATA_COORDINATES_API_URL=
AQDATA_HTTP_IDLE_TIMEOUT_S=255
WEBHOOK_IDLE_TIMEOUT_S=255

# =============================================================================
# ADDITIONAL LOCAL KEYS PRESENT IN CURRENT .env
# =============================================================================
ASSESSOR_API_KEY=your-assessor-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
COPY_FROM_APP_NUMBER=your-app-number
DUST_PERMIT_USERNAME=your-dust-permit-username
DUST_PERMIT_PASSWORD=your-dust-permit-password
EMAIL_TRIAGE_RERANK_MODE=off
EMAIL_TRIAGE_RERANK_TOP_N=10
LANGEXTRACT_API_KEY=your-langextract-api-key
MISTRAL_API_KEY=your-mistral-api-key
OUTLOOK_WEBHOOK_SECRET=your-outlook-webhook-secret
PAYMENT_BILLING_ADDRESS1=123 Example St
PAYMENT_BILLING_CITY=Phoenix
PAYMENT_BILLING_COUNTRY=US
PAYMENT_BILLING_EMAIL=billing@example.com
PAYMENT_BILLING_FIRST_NAME=Jane
PAYMENT_BILLING_LAST_NAME=Doe
PAYMENT_BILLING_PHONE=5551234567
PAYMENT_BILLING_STATE=AZ
PAYMENT_BILLING_ZIP=85001
PAYMENT_CARD_NAME=Jane Doe
PAYMENT_CARD_NUMBER=4111111111111111
PAYMENT_CARD_EXPIRY_MONTH=01
PAYMENT_CARD_EXPIRY_YEAR=2030
PAYMENT_CARD_CVV=123
PERMIT_WORKER_VNC_URL=https://permit-worker-vnc.your-domain.app
RENEW_COMPANY_NAME=Example Company LLC
RENEW_PERMIT_ID=your-permit-id
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SITELINE_API_KEY=your-siteline-api-key
SITELINE_API_URL=https://api.siteline.example
WEBHOOK_BASE_URL=https://your-webhook-domain.app
