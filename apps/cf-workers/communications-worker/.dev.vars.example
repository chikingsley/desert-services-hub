# Copy to `.dev.vars` in this directory (gitignored).
#
# Required for local manual testing:
# COMMUNICATIONS_APP_BASE_URL=http://127.0.0.1:3000
# COMMUNICATIONS_INGEST_TOKEN=replace-me
#
# Microsoft Graph app auth:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
#
# Optional: only needed for `bun run deploy` when you want Wrangler CLI auth
# to come from a local file.
# CLOUDFLARE_API_TOKEN=
