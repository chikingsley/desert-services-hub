{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communications-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-26",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "queues": {
    "producers": [
      {
        "queue": "communications-mailbox-events",
        "binding": "MAILBOX_EVENTS_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "communications-mailbox-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "communications-mailbox-events-dlq",
      },
    ],
  },
  "workflows": [
    {
      "name": "communications-submitted-billing",
      "binding": "SUBMITTED_BILLING_WORKFLOW",
      "class_name": "SubmittedBillingWorkflow",
    },
    {
      "name": "communications-submitted-client",
      "binding": "SUBMITTED_CLIENT_WORKFLOW",
      "class_name": "SubmittedClientWorkflow",
    },
    {
      "name": "communications-issued-client",
      "binding": "ISSUED_CLIENT_WORKFLOW",
      "class_name": "IssuedClientWorkflow",
    },
  ],
}
