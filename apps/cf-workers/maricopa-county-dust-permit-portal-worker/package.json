{
  "name": "maricopa-county-dust-permit-portal-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "dev:remote": "wrangler dev --remote --port 8788",
    "deploy": "wrangler deploy --env-file .dev.vars",
    "deploy:secrets": "rg -v \"^CLOUDFLARE_API_TOKEN=\" .dev.vars | wrangler secret bulk --env-file .dev.vars",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:health:deployed": "curl -sf https://maricopa-county-dust-permit-portal-worker.cheez2012.workers.dev/api/health | jq .",
    "test:portal:headed": "playwright test -c playwright.portal.config.ts",
    "test:portal:headed:login": "playwright test -c playwright.portal.config.ts tests/portal-headed/login.spec.ts",
    "test:portal:headed:login:stress": "playwright test -c playwright.portal.config.ts tests/portal-headed/login.spec.ts --repeat-each=30 --workers=1 --retries=0",
    "test:portal:headed:create": "playwright test -c playwright.portal.config.ts tests/portal-headed/create.spec.ts",
    "test:portal:headed:delete": "playwright test -c playwright.portal.config.ts tests/portal-headed/delete.spec.ts",
    "test:portal:headed:create:stress": "playwright test -c playwright.portal.config.ts tests/portal-headed/create.spec.ts --repeat-each=3 --workers=1 --retries=0",
    "playwright:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:type-aware": "ultracite check --type-aware",
    "lint:fix:type-aware": "ultracite fix --type-aware",
    "lint:doctor": "ultracite doctor"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.4",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2",
    "ultracite": "^7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  },
  "packageManager": "bun@1.3.11"
}
