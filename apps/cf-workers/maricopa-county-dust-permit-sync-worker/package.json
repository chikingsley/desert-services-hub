{
  "name": "maricopa-county-dust-permit-sync-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:remote": "wrangler dev --remote --port 8787",
    "deploy": "wrangler deploy --env-file .dev.vars",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "d1:migrate:local": "wrangler d1 migrations apply desert-services-hub --local",
    "d1:migrate:remote": "wrangler d1 migrations apply desert-services-hub --remote --env-file .dev.vars",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:doctor": "ultracite doctor"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "ultracite": "^7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  },
  "packageManager": "bun@1.3.11"
}
