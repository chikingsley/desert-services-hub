<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  </head>
  <body>
    <div>{{recipientName}},</div>
    <div><br></div>
    <div>A dust permit renewal has been submitted to Maricopa County. Please prepare for billing.</div>
    <ul>
      <li><div><b>Customer:</b> {{accountName}}</div></li>
      <li><div><b>Project:</b> {{projectName}}</div></li>
      <li><div><b>Site Address:</b> {{address}}</div></li>
      <li><div><b>Application #:</b> {{applicationNumber}}</div></li>
      <li><div><b>Superseded Application #:</b> {{supersededApplicationNumber}}</div></li>
      <li><div><b>Permit # (Facility ID):</b> {{permitNumber}}</div></li>
      <li><div><b>Accelerated Processing:</b> {{acceleratedProcessing}}</div></li>
      <li><div><b>Vendor Paid:</b> {{vendorName}}</div></li>
      <li><div><b>Permit Cost:</b> {{permitCost}}</div></li>
      {{#if acceleratedFee}}<li><div><b>Accelerated Fee:</b> {{acceleratedFee}}</div></li>{{/if}}
      <li><div><b>Schedule Value:</b> {{scheduleValue}}</div></li>
      <li><div><b>Payment Method:</b> {{paymentMethod}}</div></li>
      {{#if paymentDate}}<li><div><b>Payment Date:</b> {{paymentDate}}</div></li>{{/if}}
      {{#if confirmationId}}<li><div><b>Confirmation #:</b> {{confirmationId}}</div></li>{{/if}}
      <li><div><b>Card Last 4:</b> {{cardLastFour}}</div></li>
      <li><div><b>Cardholder:</b> {{cardholderName}}</div></li>
      <li><div><b>Invoice #:</b> {{invoiceNumber}}</div></li>
      <li><div><b>Invoice Date:</b> {{invoiceDate}}</div></li>
    </ul>
    <div>Let me know if you have any questions!</div>
    <div><br></div>
    <div>Best,</div>
    <div>--</div>
    <div><br></div>
    <div>Chi Ejimofor</div>
    <div>Project Coordinator</div>
    <div>E: <a href="mailto:chi@desertservices.net">chi@desertservices.net</a></div>
    <div>M: (304) 216-8700</div>
    <div>
      <img
        src="cid:logo"
        alt="Desert Services LLC"
        width="264"
        style="max-width:100%"
      >
    </div>
  </body>
</html>
