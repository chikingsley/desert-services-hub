{
  "name": "auto-dust-permit-application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "test:e2e": "bun test --max-concurrency 1 tests/e2e/ --bail 10",
    "test:api": "bun test tests/api/",
    "typecheck": "bunx tsc --noEmit",
    "lint": "cd ../.. && bunx biome check apps/dust-permits/src/",
    "lint:fix": "cd ../.. && bunx biome check --write apps/dust-permits/src/",
    "check": "bun run typecheck && bun run lint",
    "exp:custom-map:smoke": "bun experiments/custom-map-rehydrate/smoke.ts",
    "exp:custom-map:run": "bun experiments/custom-map-rehydrate/run.ts",
    "exp:custom-map:dataset": "bun experiments/custom-map-rehydrate/dataset-builder.ts",
    "exp:custom-map:benchmark": "bun experiments/custom-map-rehydrate/benchmark.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/msal-node": "^3.8.5",
    "@google/genai": "^1.38.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@notionhq/client": "^5.6.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/bun": "^10.32.1",
    "@tanstack/react-table": "^8.21.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.545.0",
    "pdf-lib": "^1.17.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "ultracite": "7.0.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
