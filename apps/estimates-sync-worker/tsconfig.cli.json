{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@contract/*": ["apps/contract/*"],
      "@monday/*": ["apps/monday-cli/*"],
      "@sharepoint/*": ["apps/sharepoint-cli/*"]
    }
  },
  "include": [
    "cli/sync-estimates.ts",
    "cli/validate-sharepoint.ts",
    "cli/quick-sync.ts",
    "client.ts",
    "types.ts"
  ],
  "exclude": ["node_modules", "src/**/*"]
}
