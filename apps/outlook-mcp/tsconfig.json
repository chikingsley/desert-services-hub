{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["../../lib/*"],
      "@outlook/*": ["./*"],
      "@outlook/auth/*": ["./auth/*"],
      "@outlook/email/*": ["./email/*"],
      "@outlook/folder/*": ["./folder/*"],
      "@outlook/rules/*": ["./rules/*"],
      "@outlook/utils/*": ["./utils/*"],
      "@outlook/config": ["./config"],
      "@outlook/config/*": ["./config/*"],
      "@outlook/types": ["./types"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
