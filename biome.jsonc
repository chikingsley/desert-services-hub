{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "globals": ["Bun", "HTMLRewriter"]
  },
  "files": {
    "includes": ["**/*", "!**/*.html"]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        }
      }
    }
  }
}
