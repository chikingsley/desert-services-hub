{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "globals": ["Bun", "HTMLRewriter"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "nursery": {
        "noExcessiveLinesPerFile": "error",
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!docs/_archive",
      "!apps/workers/docusign-file-automation/_reference",
      "!apps/workers/permit-workers/tests/e2e/screenshots",
      "!**/.wrangler",
      "!**/.cursor",
      "!**/inspections-app-idea"
    ]
  },
  "overrides": [
    {
      "includes": [
        "docs/_archive/**",
        "apps/workers/docusign-file-automation/_reference/**"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["lib/takeoff/pdf-takeoff/components/**/*"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useKeyWithMouseEvents": "off",
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "correctness": {
            "useImageSize": "off",
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/App.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/components/ui/**/*"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/frontend/components/catalog/catalog-category-card.tsx",
        "apps/web/frontend/components/takeoffs/takeoff-viewer.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/frontend/components/takeoffs/new-takeoff-dialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off"
          }
        }
      }
    }
  ]
}
