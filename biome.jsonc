{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "globals": ["Bun", "HTMLRewriter"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!docs/_archive",
      "!services/docusign-file-automation/_reference",
      "!**/.wrangler",
      "!**/.cursor",
      "!**/inspections-app-idea",
      "!apps/auto-permit/docs/page-snapshots",
      "!apps/auto-permit/docs/auto-custom-map-for-dust-permit",
      "!apps/auto-permit/docs/agentic-finance-review",
      "!apps/auto-permit/data/samples",
      "!apps/auto-permit/tests/e2e/screenshots",
      "!apps/auto-permit/tests/output",
      "!apps/auto-permit/scripts",
      "!apps/auto-permit/dashboard",
      "!apps/auto-permit/build.ts",
      "!apps/auto-permit/src/components/ui"
    ]
  },
  "overrides": [
    {
      "includes": [
        "docs/_archive/**",
        "services/docusign-file-automation/_reference/**"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["lib/takeoff/pdf-takeoff/components/**/*"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useKeyWithMouseEvents": "off",
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "correctness": {
            "useImageSize": "off",
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/App.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/components/ui/**/*"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/frontend/components/catalog/catalog-category-card.tsx",
        "apps/web/frontend/components/takeoffs/takeoff-viewer.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/frontend/components/takeoffs/new-takeoff-dialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/.claude/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noEmptyBlockStatements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/dashboard/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/docs/**", "apps/auto-permit/tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/auto-permit/src/portal/create/fill/page4/category-*.ts",
        "apps/auto-permit/src/portal/create/fill/page1.ts",
        "apps/auto-permit/tests/e2e/utils/element-recorder.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/src/frontend.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auto-permit/src/App.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
