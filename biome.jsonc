{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "globals": ["Bun", "Deno", "HTMLRewriter", "__ENV", "__VU", "__ITER"]
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.cts",
      "**/*.mts",
      "**/*.json",
      "**/*.jsonc",
      "!**/*.html",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/coverage",
      "!**/.turbo",
      "!**/.tmp",
      "!tmp",
      "!apps/inbox-zero",
      "!apps/dust-permits/experiments",
      "!apps/cf-workers/docusign-file-automation/_reference",
      "!apps/cf-workers/inspections-email-worker/inspections-app-idea"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/dust-permits/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/components/takeoffs/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithMouseEvents": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/takeoff/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "useImageSize": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "evals/**", "ops/load-tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noVoid": "off"
          },
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noMisplacedAssertion": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": ["root/docker/resource-broker/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noVoid": "off"
          },
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/trigger-dev/src/trigger/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/frontend/pages/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/bc-worker/src/api/auth.ts",
        "apps/dust-permits-mcp/src/tools.ts",
        "lib/email/sync.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/hatchet/src/tasks/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/takeoff/src/pdf-takeoff/components/use-pdf-highlighter.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ]
}
