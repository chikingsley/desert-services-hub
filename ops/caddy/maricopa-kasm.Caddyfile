{$MARICOPA_KASM_HOST} {
	request_body {
		max_size 10MB
	}

	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors https://web.desertservices.app"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		Permissions-Policy "cross-origin-isolated=(self)"
	}

	reverse_proxy permit-worker-kasm:8444 {
		header_up Authorization "Basic {$KASMVNC_BASIC_AUTH}"
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 30s
			read_timeout 1800s
			write_timeout 1800s
		}
	}
}
