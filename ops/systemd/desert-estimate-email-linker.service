[Unit]
Description=Desert Services Estimate Email Linker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/desert-services-hub
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/github/desert-services-hub/.env

# Conservative linking: default disables project->single-estimate heuristic.
# Uses estimate_poller_config key estimate_email_linker_last_email_id for cursor.
ExecStart=%h/.bun/bin/bun run apps/workers/estimate-email-linker/cli/run.ts --interval=60000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

