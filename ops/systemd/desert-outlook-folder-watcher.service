[Unit]
Description=Desert Services Outlook Folder Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/desert-services-hub
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/github/desert-services-hub/.env
ExecStart=%h/.bun/bin/bun run apps/workers/outlook-folder-watcher/cli/watch.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
