[Unit]
Description=Desert Services SWPPP Sync Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/desert-services-hub
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/github/desert-services-hub/.env
ExecStart=%h/.bun/bin/bun run apps/workers/swppp-sync/cli/sync.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
