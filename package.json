{
  "name": "desert-services-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/cf-workers/*",
      "apps/cf-workers/*/*"
    ],
    "catalog": {
      "@azure/identity": "^4.13.0",
      "@microsoft/microsoft-graph-client": "^3.0.7",
      "@biomejs/biome": "2.3.13",
      "@types/bun": "^1.3.8",
      "typescript": "^5.9.3",
      "ultracite": "7.1.4",
      "wrangler": "^4.65.0",
      "@cloudflare/workers-types": "^4.20260131.0"
    }
  },
  "scripts": {
    "cli": "bun run cli.ts",
    "dev": "bun --hot src/server.ts",
    "start": "bun run src/server.ts",
    "ops:up": "just up",
    "ops:health": "just status",
    "ops:check": "just check",
    "ops:services:install": "just services-install",
    "ops:cf:check": "just cf-check",
    "typecheck": "bun run typecheck:root && bun run typecheck:inbox-zero",
    "typecheck:root": "tsc --noEmit",
    "typecheck:inbox-zero": "bash -lc 'cd apps/inbox-zero/apps/web && bunx tsc --noEmit --pretty false'",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "test": "bun test tests/",
    "triage:rerank:replay": "bun scripts/triage-rerank-replay.ts",
    "permit:mcp": "bun apps/dust-permits-mcp/index.ts",
    "siteline": "bun packages/siteline/cli.ts",
    "siteline:mcp": "bun packages/siteline/mcp.ts",
    "permits:guard:no-mock": "bash -lc 'if rg -n \"Bun\\\\.serve\\\\(\" packages/permits/tests; then echo \"Mock servers are not allowed in packages/permits/tests\"; exit 1; fi'",
    "permits:test:client": "bun run permits:guard:no-mock && bun test tests/packages/permits/tests/client.test.ts",
    "permits:test:renew-and-pay": "docker exec desert-permit-worker sh -lc \"cd /app/apps/dust-permits && bun test tests/e2e/renew-and-pay.test.ts\"",
    "pdf": "bun packages/documents/pdf-generation/cli/cli.ts --help",
    "db:supabase:start": "npx --yes supabase start --workdir .",
    "db:supabase:stop": "npx --yes supabase stop --workdir .",
    "db:supabase:status": "npx --yes supabase status --workdir .",
    "db:supabase:env": "bash scripts/db/supabase-env.sh",
    "db:migrate:snapshot": "bash scripts/db/snapshot-hub.sh",
    "db:migrate:local-pg": "bash scripts/db/sqlite-to-local-postgres.sh",
    "db:migrate:verify": "bash scripts/db/verify-local-postgres.sh",
    "outlook:project-folder:audit": "bun scripts/outlook-project-folder-audit.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@azure/identity": "^4.13.0",
    "@azure/msal-node": "^5.0.3",
    "@google/genai": "^1.40.0",
    "@hatchet-dev/typescript-sdk": "^1.15.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@mistralai/mistralai": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/bun": "^10.39.0",
    "@simonpeacocks/react-vnc": "3.3.0",
    "@trigger.dev/sdk": "^4.4.1",
    "bun-plugin-tailwind": "^0.1.2",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "handlebars": "^4.7.8",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.9.3",
    "maplibre-gl": "^5.17.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pdfmake": "^0.3.3",
    "peopledatalabs": "^14.1.1",
    "playwright": "^1.58.2",
    "react": "19.1.0",
    "react-day-picker": "9.13.1",
    "react-dom": "19.1.0",
    "react-rnd": "^10.5.2",
    "react-router": "^7.13.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "terra-draw": "^1.24.0",
    "terra-draw-maplibre-gl-adapter": "^1.3.0",
    "tiny-invariant": "^1.3.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.8",
    "@types/cli-progress": "^3.11.6",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.2.1",
    "@types/pdfmake": "^0.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.2.3"
  }
}
