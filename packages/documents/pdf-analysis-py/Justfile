default:
    @just --list

install:
    uv sync

clean:
    find . -type d -name "__pycache__" -prune -exec find {} -type f -delete \; -exec rmdir {} \; 2>/dev/null || true
    find . -type d -name ".pytest_cache" -prune -exec find {} -type f -delete \; -exec find {} -depth -type d -empty -delete \; 2>/dev/null || true
    find . -type d -name ".ruff_cache" -prune -exec find {} -type f -delete \; -exec find {} -depth -type d -empty -delete \; 2>/dev/null || true
    find . -type d -name ".venv" -prune -exec find {} \( -type f -o -type l \) -exec unlink {} \; \; -exec find {} -depth -type d -empty -delete \; 2>/dev/null || true
    find . -name ".DS_Store" -type f -delete 2>/dev/null || true

status:
    uv run pdf-analysis status

ocr pdf_path:
    uv run plan-ocr gemini-ocr {{pdf_path}}

ocr-limit pdf_path max_pages:
    uv run plan-ocr gemini-ocr {{pdf_path}} --max-pages {{max_pages}}

estimate pdf_path:
    uv run pdf-analysis estimate {{pdf_path}}

estimate-text pdf_path:
    uv run pdf-analysis estimate {{pdf_path}} --format text

noi pdf_path:
    uv run pdf-analysis noi {{pdf_path}}

noi-text pdf_path:
    uv run pdf-analysis noi {{pdf_path}} --format text

check:
    uv run ruff check src/

fix:
    uv run ruff check --fix src/

fmt:
    uv run ruff format src/

test:
    uv run pytest

test-file file:
    uv run pytest {{file}}

test-node nodeid:
    uv run pytest {{nodeid}}
