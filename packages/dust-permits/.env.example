# Auto-Dust-Permit Configuration

# -----------------------------------------------------------------------------
# 1. CORE CREDENTIALS (Required)
# -----------------------------------------------------------------------------

# Maricopa County Portal Login
DUST_PERMIT_USERNAME=your_email@example.com
DUST_PERMIT_PASSWORD=your_secure_password

# Google Gemini API Key (for PDF extraction and intelligent form filling)
# Get one here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Application Settings
COMPANY_NAME=Sundt Construction Inc
# Defaults to D0055574 if not set
COPY_FROM_APP_NUMBER=D0062461
# Set to 'true' to force New Company flow, otherwise auto-detected via CSV
IS_NEW_COMPANY=false

# -----------------------------------------------------------------------------
# 3. ADVANCED (Optional)
# -----------------------------------------------------------------------------

# Maricopa County Assessor API (for improved address lookup)
ASSESSOR_API_KEY=your_assessor_key

# Jina AI (for web scraping)
JINA_API_KEY=your_jina_key

# Browser Configuration
# Set to 'false' to watch the browser (via VNC or local), 'true' for background
HEADLESS=true

# -----------------------------------------------------------------------------
# 4. MICROSOFT GRAPH API + TEAMS BOT (Optional)
# -----------------------------------------------------------------------------

# Azure Entra ID App Registration (consolidated - one app for Graph + Bot)
# Create at: https://portal.azure.com → Microsoft Entra ID → App registrations
# Register bot at: https://dev.teams.microsoft.com → Tools → Bot management
# Required permissions (Application, grant admin consent):
#   - Mail.Send (for email)
#   - AppCatalog.ReadWrite.All (for Teams app deployment)
#   - TeamsAppInstallation.ReadWriteForTeam.All (install bot in teams)
#   - TeamsAppInstallation.ReadWriteForUser.All (install bot for users)
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_app_client_id
AZURE_CLIENT_SECRET=your_app_client_secret
