<tr><td>CRPT004046</td><td>F001745</td><td>Arizona Materials Portable #1</td><td>Minor</td><td>Concrete Plant, Portable</td><td>CMP000309</td><td>Arizona Materials LLC</td><td>Compliance Report</td><td>Portable Equipment Move Notice</td><td>Moved our portable. Address update.</td><td>11/12/2021</td><td>11/18/2021</td><td>No-Revision Requested</td><td>&nbsp;</td><td>Good morning Ms. Balmer,

