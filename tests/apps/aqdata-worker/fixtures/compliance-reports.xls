<tr><td>CRPT003940</td><td>F001209</td><td>SR 85 Landfill</td><td>Title V</td><td>Landfills</td><td>CMP000821</td><td>City of Phoenix</td><td>Compliance Report</td><td>Periodic Reporting</td><td>SR85 Landfill Semi-Annual Compliance/Monitoring Report for 4/4/2021 to 10/3/2021</td><td>10/26/2021</td><td>09/01/2023</td><td>Yes</td><td>&nbsp;</td><td>SR85 Semiannual Monitoring Report for April 4 - October 3, 2021 reporting period.

