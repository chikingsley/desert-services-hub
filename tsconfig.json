{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@contract/*": [
        "apps/contract-ui/contract/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@/components/*": [
        "apps/web/frontend/components/*"
      ],
      "@/pages/*": [
        "apps/web/frontend/pages/*"
      ],
      "@/api/*": [
        "apps/web/api/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "workers",
    "projects",
    "docs/_archive",
    "docs/_archive/**/*",
    "docs/archive",
    "docs/archive/**/*",
    "app",
    "bun-init",
    "bun-example",
    "components",
    "services/contract/file-automation",
    "services/contract/agents_archive",
    "services/contract/census/_archive",
    "services/file-automation/_reference",
    "services/email/inbox",
    "**/mcp-server.ts",
    "**/mcp-server.*.ts",
    "**/*.mcp.test.ts"
  ]
}