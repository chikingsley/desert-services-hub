{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@contract/*": ["apps/contract/*"],
      "@services/*": ["services/*"],
      "@lib/*": ["lib/*"],
      "@/components/*": ["apps/web/frontend/components/*"],
      "@/pages/*": ["apps/web/frontend/pages/*"],
      "@/api/*": ["apps/web/api/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "workers",
    "docs/_archive",
    "services/file-automation/_reference",
    "services/email/inbox",
    "**/*.mcp.test.ts",
    "**/build.ts",
    "apps/contract-ui/sample-apps"
  ]
}
