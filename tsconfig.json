{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@contract/*": ["apps/contract/*"],
      "@monday/*": ["apps/cli-tools/monday-cli/*"],
      "@sharepoint/*": ["apps/cli-tools/sharepoint-cli/*"],
      "@email/*": ["apps/cli-tools/email-cli/*"],
      "@lib/*": ["lib/*"],
      "@/components/*": ["apps/web/frontend/components/*"],
      "@/pages/*": ["apps/web/frontend/pages/*"],
      "@/api/*": ["apps/web/api/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/build.ts",
    "apps/auto-permit",
    "services/docusign-file-automation/_reference"
  ]
}
