{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib/utils": ["apps/web/frontend/lib/utils.ts"],
      "@/hooks/*": ["apps/web/frontend/hooks/*"],
      "@/components/*": ["apps/web/frontend/components/*"],
      "@/pages/*": ["apps/web/frontend/pages/*"],
      "@/api/*": ["apps/web/api/*"],
      "@/form-data": ["apps/dust-permits/src/form-data.ts"],
      "@/portal/*": ["apps/dust-permits/src/portal/*"],
      "@/lib/assessor": ["apps/dust-permits/src/lib/assessor.ts"],
      "@contract/*": ["packages/contracts/src/*"],
      "@email/*": ["packages/email/src/*"],
      "@monday/*": ["packages/monday/src/*"],
      "@projects/*": ["packages/projects/src/*"],
      "@sharepoint/*": ["packages/sharepoint/src/*"],
      "@enrichment/*": ["packages/enrichment/src/*"],
      "@documents/*": ["packages/documents/pdf-generation/src/*"],
      "@documents-intake/*": ["packages/documents/intake/src/*"],
      "@accounts/*": ["packages/accounts/src/*"],
      "@takeoff/*": ["packages/takeoff/src/*"],
      "@estimates/*": ["packages/estimates/src/*"],
      "@dust-permits/*": ["apps/dust-permits/src/*"],
      "@permits/*": ["apps/dust-permits-mcp/permits/src/*"],
      "@siteline/*": ["packages/siteline/src/*"],
      "@triage/*": ["packages/archive/email/sync/triage/*"],
      "@lib/*": ["lib/*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/build.ts",
    "**/tests/**",
    "**/_reference/**",
    "apps/inbox-zero",
    "apps/dust-permits",
    "apps/aqdata-worker",
    "apps/outlook-mcp"
  ]
}
