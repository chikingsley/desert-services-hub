{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/hooks/*": ["apps/web/frontend/hooks/*"],
      "@/components/*": ["apps/web/frontend/components/*"],
      "@/pages/*": ["apps/web/frontend/pages/*"],
      "@/api/*": ["apps/web/api/*"],
      "@background-jobs/*": ["apps/background-jobs/*"],
      "@contract/*": ["packages/contracts/*"],
      "@monday/*": ["packages/monday/src/*"],
      "@sharepoint/*": ["packages/sharepoint/src/*"],
      "@email/*": ["packages/email/src/*"],
      "@aqdata/*": ["packages/aqdata/src/*"],
      "@documents/*": ["packages/documents/src/*"],
      "@takeoff/*": ["packages/takeoff/src/*"],
      "@estimates/*": ["packages/estimates/src/*"],
      "@permits/*": ["packages/permits/src/*"],
      "@lib/*": ["lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/build.ts",
    "apps/cf-workers/docusign-file-automation/_reference",
    "apps/dust-permits"
  ]
}
